# --- Server ---
NODE_ENV=development
PORT=5000
# Public URL of this API (used to build image URLs for uploaded files)
SERVER_URL=http://localhost:5000
# Frontend origin allowed by CORS (Next.js dev server)
CLIENT_URL=http://localhost:3000

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/campuscart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscart
MONGODB_URI=mongodb://127.0.0.1:27017/campuscart

# --- Auth ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated college email domains allowed to register.
# Leave empty in development to allow any email. Set it in production!
ALLOWED_EMAIL_DOMAINS=youruni.edu.in

# If true, users must click the emailed link before they can log in.
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (optional). Without SMTP_HOST, verification links are printed to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusCart <no-reply@campuscart.local>"
